# Dependencies / caches that must never reach the repository
__pycache__/
*.pyc
.venv/
venv/

# Local scratch
.DS_Store
Thumbs.db
desktop.ini
*.log

# Local preview screenshots (not part of the published site)
docs/

# Manuscript artefacts — never publish the full text from this repository
*.pdf
*.docx
*.doc
*.tex
*.zip

# Local preview / tooling
.cache/

# A GitHub Actions workflow is intentionally absent: pushing one needs a PAT
# with the extra `workflow` scope. Pages publishes straight from the `main`
# branch root instead. See .github/.gitignore.
.github/workflows/
